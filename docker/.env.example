# Copy to .env and edit before docker compose up -d

# Path to chip documentation on the host (mounted read-only into the container)
DOCS_PATH=/path/to/chip/docs

# SiliconFlow API key for embedding and rerank
SILICONFLOW_API_KEY=sk-your-key-here

# Public repository name (used for Qdrant collection: rags_<name>)
RAGS_NAME=bk7258-docs

# Host port published for search API (written into .rags as endpoint)
RAGS_PORT=18787

# Host address clients use in .rags endpoint (use server IP if remote clients search)
RAGS_PUBLIC_HOST=127.0.0.1

# Optional: embedding / rerank models
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSIONS=4096
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# Set to 1 to run rags update on every container start
RAGS_AUTO_UPDATE=0

# Parallel indexing workers during rags update (default: min(8, NumCPU))
RAGS_INDEX_WORKERS=8
