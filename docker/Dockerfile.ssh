FROM golang:1.23-alpine AS build

ARG GOPROXY=https://goproxy.cn,direct
ENV GOPROXY=${GOPROXY}

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /rags ./cmd/rags

FROM alpine:3.20

RUN apk add --no-cache \
        bash \
        ca-certificates \
        coreutils \
        file \
        findutils \
        grep \
        jq \
        less \
        nano \
        openssh-server \
        ripgrep \
        shadow \
        tree \
    && addgroup -S knowledge \
    && adduser -S -D -h /home/knowledge -s /bin/bash -G knowledge knowledge \
    && mkdir -p /etc/ssh/host_keys \
    && chmod 0755 /etc/ssh/host_keys

COPY --from=build /rags /usr/local/bin/rags
COPY docker/sshd_config /etc/ssh/sshd_config
COPY docker/ssh-entrypoint.sh /usr/local/bin/ssh-entrypoint

RUN chmod 0755 /usr/local/bin/rags /usr/local/bin/ssh-entrypoint

EXPOSE 22

ENTRYPOINT ["/usr/local/bin/ssh-entrypoint"]
